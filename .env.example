# TTS Fun – environment variables
# Copy to .env and adjust as needed before running docker compose up

# ── Backend ──────────────────────────────────────────────────────────────────
# "cuda" uses NVIDIA GPU (requires NVIDIA Container Toolkit)
# "cpu"  uses CPU only (slower, but works anywhere)
BACKEND=cuda

# CUDA version baked into the base image (adjust to match your driver)
# Available: 12.6.0, 12.8.0, 12.9.0, 13.1.0
CUDA_VER=12.9.0

# Matching uv extra for PyTorch: cu126 | cu128 | cu129 | cpu
# Note: PyTorch does not yet publish cu131 wheels; use cu128 for CUDA 13.x hosts.
UV_EXTRA=cu129

# ── Inference ─────────────────────────────────────────────────────────────────
# Set to 1 to enable torch.compile (~10x speedup, CUDA only, first run slower)
COMPILE=0

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000

# ── Podcast / LLM ─────────────────────────────────────────────────────────────
# Ollama model used to generate podcast scripts.
# qwen2.5:7b is recommended — fully open-source (Apache 2.0), ~4.7 GB,
# runs comfortably on RTX 5080 (16 GB VRAM).
# Alternative: mistral:7b, llama3.1:8b
LLM_MODEL=qwen2.5:7b
