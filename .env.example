# TTS Fun – environment variables
# Copy to .env and adjust as needed before running docker compose up

# ── Backend ──────────────────────────────────────────────────────────────────
# "cuda" uses NVIDIA GPU (requires NVIDIA Container Toolkit)
# "cpu"  uses CPU only (slower, but works anywhere)
BACKEND=cuda

# CUDA version baked into the base image (adjust to match your driver)
# Available: 12.6.0, 12.8.0, 12.9.0
CUDA_VER=12.6.0

# Matching uv extra for PyTorch: cu126 | cu128 | cu129 | cpu
UV_EXTRA=cu126

# ── Inference ─────────────────────────────────────────────────────────────────
# Set to 1 to enable torch.compile (~10x speedup, CUDA only, first run slower)
COMPILE=0

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
